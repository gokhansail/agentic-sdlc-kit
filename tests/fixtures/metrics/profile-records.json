{
  "schema": 1,
  "files": {
    "changelog": "CHANGELOG.md",
    "decisions": "DECISIONS.md",
    "tasks": "TASKS.md"
  },
  "folders": {
    "audits": {
      "dir": "reports",
      "name": "^(?P<date>\\d{4}-\\d{2}-\\d{2})_.+\\.md$",
      "skip": "skipme"
    }
  },
  "metrics": {
    "M3": {
      "path_glob": "tests/*.cs",
      "attribute": "^[[:space:]]*\\[Probe[],(]"
    },
    "M8": {
      "folder": "audits",
      "finding_heading": "^###\\s+(?P<id>[a-z]+-\\d+)\\s+\\u2014\\s+(?P<severity>[a-z]+)\\b",
      "table_row": "^\\|\\s*(?P<id>[a-z]+-\\d+)\\s*\\|(?:.*\\|)?\\s*(?P<status>closed|partial|open|deferred)\\b[^|]*\\|\\s*$"
    },
    "M9": {
      "file": "decisions",
      "entry_heading": "^\\*\\*d-\\d+(?:.*?\\u2014\\s*(?P<date>\\d{4}-\\d{2}-\\d{2}))?",
      "outcome": "^\\s*(?:-\\s+)?\\*{0,2}outcome\\s*(?:\\([^)]*\\))?\\s*:\\s*\\*{0,2}\\s*(?P<value>.*)$",
      "empty": "^\\u2014$"
    },
    "M12": {
      "commits": true,
      "file": "changelog",
      "version_heading": "^##\\s+(?:\\([^)]*\\)\\s+)?v?\\d+\\.\\d+\\.\\d+",
      "date": "^##\\s+\\S+\\s+\\u2014\\s+(?:\\d{4}-\\d{2}-\\d{2}\\s*[-\\u2013]\\s*)?(?P<date>\\d{4}-\\d{2}-\\d{2})"
    },
    "M13": {
      "file": "tasks",
      "heading": "^###\\s+\\[(?P<done>[ x~])\\]\\s+[a-z]+-\\d+",
      "tag": "^###\\s+\\[[ x~]\\]\\s+[a-z]+-\\d+\\s+\\[(?P<tag>[a-z])\\]",
      "tags": {"E": "s", "M": "m", "H": "l"},
      "done_date": "\\((?P<date>\\d{4}-\\d{2}-\\d{2})\\b[^)]*\\)\\s*$"
    }
  }
}
