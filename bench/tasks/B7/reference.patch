+++ b/budgetbook/tables.py
@@ -0,0 +1,135 @@
+"""Table output as data: columns, rows and the lines around them, in three renderings.
+
+A table command builds a ``Table`` and this module turns it into text, JSON or CSV, so no
+command lays out its own output. Nothing here prints; callers write the returned string.
+"""
+from __future__ import annotations
+
+import csv
+import io
+import json
+from dataclasses import dataclass
+from typing import Any, Callable, Sequence
+
+from .textfmt import pad_left, pad_right
+
+FORMATS = ("text", "json", "csv")
+
+
+@dataclass(frozen=True)
+class Column:
+    """One column: how to read it from a row and how it is named and shown.
+
+    ``key`` is the JSON key and the CSV header. ``get`` returns the value for JSON and CSV
+    (a string, an integer or None). ``text`` gives the text cell when it differs from the
+    value, and ``in_text`` False leaves the column out of the text output.
+    """
+
+    key: str
+    header: str
+    get: Callable[[Any], str | int | None]
+    right: bool = False
+    text: Callable[[Any], str] | None = None
+    in_text: bool = True
+
+    def text_cell(self, row: Any) -> str:
+        if self.text is not None:
+            return self.text(row)
+        value = self.get(row)
+        return "" if value is None else str(value)
+
+
+@dataclass(frozen=True)
+class Table:
+    """The output of one command.
+
+    ``layout`` is how the text shows the rows: ``grid`` (an aligned table), ``pairs``
+    (``  name: value`` lines under ``rows_title``) or ``fields`` (``Header: value`` lines
+    for a single row). ``head`` and ``foot`` are text lines around the rows, ``empty`` the
+    only text line when there are no rows, and ``text_only_rows`` rows that end the text
+    grid but are not data (a total). ``before`` and ``after`` are JSON fields around the
+    rows; ``rows_key`` None puts the fields of the single row into the document itself.
+    """
+
+    columns: Sequence[Column]
+    rows: Sequence[Any]
+    rows_key: str | None
+    layout: str = "grid"
+    head: Sequence[str] = ()
+    foot: Sequence[str] = ()
+    empty: str | None = None
+    rows_title: str = ""
+    text_only_rows: Sequence[Any] = ()
+    before: Sequence[tuple[str, Any]] = ()
+    after: Sequence[tuple[str, Any]] = ()
+
+
+def format_table(
+    headers: Sequence[str], rows: Sequence[Sequence[str]], right: Sequence[int] = ()
+) -> list[str]:
+    """Lay out a table with two spaces between columns; columns in ``right`` are right-aligned."""
+    widths = [len(header) for header in headers]
+    for row in rows:
+        for index, cell in enumerate(row):
+            widths[index] = max(widths[index], len(cell))
+
+    def line(cells: Sequence[str]) -> str:
+        padded = [
+            pad_left(cell, widths[i]) if i in right else pad_right(cell, widths[i])
+            for i, cell in enumerate(cells)
+        ]
+        return "  ".join(padded).rstrip()
+
+    return [line(headers)] + [line(row) for row in rows]
+
+
+def _text_body(table: Table) -> list[str]:
+    shown = [column for column in table.columns if column.in_text]
+    rows = list(table.rows) + list(table.text_only_rows)
+    if table.layout == "grid":
+        cells = [[column.text_cell(row) for column in shown] for row in rows]
+        right = tuple(index for index, column in enumerate(shown) if column.right)
+        return format_table([column.header for column in shown], cells, right)
+    if table.layout == "pairs":
+        lines = [f"  {shown[0].text_cell(row)}: {shown[1].text_cell(row)}" for row in rows]
+        return [table.rows_title] + lines if lines else []
+    return [f"{column.header}: {column.text_cell(rows[0])}" for column in shown]
+
+
+def render_text(table: Table) -> str:
+    """The text output without a final newline."""
+    if table.empty is not None and not table.rows:
+        return table.empty
+    return "\n".join([*table.head, *_text_body(table), *table.foot])
+
+
+def render_json(table: Table) -> str:
+    document: dict[str, Any] = dict(table.before)
+    records = [{column.key: column.get(row) for column in table.columns} for row in table.rows]
+    if table.rows_key is None:
+        document.update(records[0])
+    else:
+        document[table.rows_key] = records
+    document.update(table.after)
+    return json.dumps(document, indent=2, ensure_ascii=False) + "\n"
+
+
+def render_csv(table: Table) -> str:
+    buffer = io.StringIO(newline="")
+    writer = csv.writer(buffer, lineterminator="\n")
+    writer.writerow([column.key for column in table.columns])
+    for row in table.rows:
+        values = [column.get(row) for column in table.columns]
+        writer.writerow(["" if value is None else value for value in values])
+    return buffer.getvalue()
+
+
+def render(table: Table, fmt: str) -> str:
+    """The text to write to standard output, ending in a newline, for one of ``FORMATS``."""
+    if fmt == "json":
+        return render_json(table)
+    if fmt == "csv":
+        return render_csv(table)
+    if fmt == "text":
+        return render_text(table) + "\n"
+    raise ValueError(f"unknown format: {fmt!r}")
