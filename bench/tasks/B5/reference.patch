@@ -0,0 +1,69 @@
+"""Where the data of a ledger is kept.
+
+A ledger turns itself into a plain dict (``Ledger.to_dict``) and hands it to a ``Storage``;
+it gets the dict back from ``load``. ``JsonFileStorage`` is the file used by the command
+line; ``MemoryStorage`` keeps the data in the process, for tests and short-lived tools.
+"""
+from __future__ import annotations
+
+import copy
+import json
+import os
+from abc import ABC, abstractmethod
+from pathlib import Path
+
+from .errors import LedgerFileError
+
+
+class Storage(ABC):
+    """Reads and writes the data dict of one ledger."""
+
+    @abstractmethod
+    def load(self) -> dict | None:
+        """The stored data, or None when nothing is stored yet."""
+
+    @abstractmethod
+    def save(self, data: dict) -> None:
+        """Store the data, replacing what was stored before."""
+
+
+class MemoryStorage(Storage):
+    """Keeps a copy of the data in memory; nothing leaks in or out by reference."""
+
+    def __init__(self) -> None:
+        self._data: dict | None = None
+
+    def load(self) -> dict | None:
+        return None if self._data is None else copy.deepcopy(self._data)
+
+    def save(self, data: dict) -> None:
+        self._data = copy.deepcopy(data)
+
+
+class JsonFileStorage(Storage):
+    """One JSON file. The write is atomic: the old file stays intact if it fails."""
+
+    def __init__(self, path: str | os.PathLike) -> None:
+        self.path = Path(path)
+
+    def load(self) -> dict | None:
+        if not self.path.exists():
+            return None
+        try:
+            data = json.loads(self.path.read_text(encoding="utf-8"))
+        except json.JSONDecodeError as exc:
+            raise LedgerFileError(f"{self.path}: not valid JSON ({exc.msg})") from exc
+        if not isinstance(data, dict):
+            raise LedgerFileError(f"{self.path}: expected a JSON object")
+        return data
+
+    def save(self, data: dict) -> None:
+        payload = json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = self.path.with_name(self.path.name + ".tmp")
+        try:
+            tmp.write_text(payload, encoding="utf-8", newline="\n")
+            os.replace(tmp, self.path)
+        except BaseException:
+            tmp.unlink(missing_ok=True)
+            raise
