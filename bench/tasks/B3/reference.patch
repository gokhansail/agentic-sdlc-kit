+def render_budget_status(statuses: Sequence[BudgetStatus]) -> str:
+    if not statuses:
+        return "No budgets set."
+    lines = ["Budgets:"]
+    for item in statuses:
+        whole, tenth = divmod(item.percent_tenths, 10)
+        lines.append(
+            f"{item.category} {format_amount(item.spent)} {format_amount(item.limit)} {whole}.{tenth}% {item.status}"
+        )
+    return "\n".join(lines)
+
