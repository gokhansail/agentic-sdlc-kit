 """Monthly budgets per category. The limits live in ``Ledger.budgets`` (category to cents)."""
 from __future__ import annotations

-from .categories import normalize_category
+from dataclasses import dataclass
+
+from .categories import is_within, normalize_category
 from .errors import AmountError, NotFoundError
 from .ledger import Ledger
+from .money import round_half_up_div
+
+WARN_TENTHS = 800  # 80.0 percent


 def set_budget(ledger: Ledger, category: str, limit: int) -> str:
@@ -29,3 +34,46 @@ def remove_budget(ledger: Ledger, category: str) -> None:
 def all_budgets(ledger: Ledger) -> list[tuple[str, int]]:
     """Every budget as ``(category, limit)``, ordered by category name."""
     return sorted(ledger.budgets.items())
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    category: str
+    spent: int
+    limit: int
+    percent_tenths: int  # spent as a percentage of the limit, in tenths of a percent
+    status: str  # OK, WARN or OVER
+
+
+def spent_in_month(ledger: Ledger, category: str, year: int, month: int) -> int:
+    """Net expenses of a category and the categories below it in a month, never below zero.
+
+    Refunds in the category reduce the amount.
+    """
+    name = normalize_category(category)
+    total = sum(
+        tx.amount
+        for tx in ledger.in_month(year, month)
+        if is_within(normalize_category(tx.category), name)
+    )
+    return max(-total, 0)
+
+
+def budget_statuses(ledger: Ledger, year: int, month: int) -> list[BudgetStatus]:
+    """One status per budget, ordered by category name.
+
+    The percentage is rounded to one decimal, halves up. OVER means more than the limit was
+    spent; WARN means the rounded percentage is 80.0 or more.
+    """
+    statuses = []
+    for category, limit in all_budgets(ledger):
+        spent = spent_in_month(ledger, category, year, month)
+        tenths = round_half_up_div(spent * 1000, limit)
+        if spent > limit:
+            status = "OVER"
+        elif tenths >= WARN_TENTHS:
+            status = "WARN"
+        else:
+            status = "OK"
+        statuses.append(BudgetStatus(category, spent, limit, tenths, status))
+    return statuses
