{
  "schema": 1,
  "files": {
    "changelog": "CHANGELOG.md",
    "log": "LOG.md"
  },
  "metrics": {
    "M1": {},
    "M2": {},
    "M5": {
      "file": "log",
      "entry_heading": "^##\\s+(?P<date>\\d{4}-\\d{2}-\\d{2})",
      "task_line": "^\\s*-\\s+metrics\\s*\\(",
      "fields": {
        "review_rounds": "\\breview rounds\\s+(?P<n>\\d+)"
      }
    },
    "M6": {
      "file": "log",
      "entry_heading": "^##\\s+(?P<date>\\d{4}-\\d{2}-\\d{2})",
      "task_line": "^\\s*-\\s+metrics\\s*\\(",
      "fields": {
        "questions_back": "\\bquestions back\\s+(?P<n>\\d+)",
        "out_of_scope": "\\bout-of-scope files\\s+(?P<n>\\d+)"
      }
    }
  }
}
