{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"$CLAUDE_PROJECT_DIR\" sh \"$CLAUDE_PROJECT_DIR/hooks/scope/launcher.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
